<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splash_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/jm_ink"
    android:clipChildren="false">

    <LinearLayout
        android:id="@+id/splash_content"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp">

        <!-- El apretón v8: las dos manos entran desde lados opuestos y
             se encuentran en el centro (la izquierda desde la
             izquierda, la derecha desde la derecha), y luego se
             estrechan juntas. Las dos capas comparten viewBox 96 y el
             mismo tamaño, así se superponen con exactitud al
             encontrarse. -->
        <FrameLayout
            android:id="@+id/mark_stage"
            android:layout_width="156dp"
            android:layout_height="156dp"
            android:clipChildren="false">

            <ImageView
                android:id="@+id/hand_right"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cp_hand_right_light" />

            <ImageView
                android:id="@+id/hand_left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cp_hand_left_light" />
        </FrameLayout>

        <!-- La máscara del nombre: el nombre emerge desde abajo, como
             en el HTML de Henry (overflow hidden + translateY). El
             marco recorta el texto mientras sube y se posa exacto. -->
        <FrameLayout
            android:id="@+id/name_mask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.015"
                android:text="@string/app_name"
                android:textColor="@color/cpWhite"
                android:textSize="30sp" />
        </FrameLayout>

        <!-- La frase, como en el HTML: cursiva, y se asoma hasta 0.7. -->
        <TextView
            android:id="@+id/tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="@string/tagline"
            android:textColor="@color/splash_tagline"
            android:textSize="15sp"
            android:textStyle="italic" />
    </LinearLayout>
</FrameLayout>
