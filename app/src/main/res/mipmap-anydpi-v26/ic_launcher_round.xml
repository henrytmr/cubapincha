<?xml version="1.0" encoding="utf-8"?>
<!-- Icono adaptativo v8 (el apretón de manos): fondo marfil,
     primer plano transparente y variante monocromo para los iconos
     temáticos de Android 13+ (en versiones anteriores se ignora).
     El icono es el mismo de día y de noche. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
