<?xml version="1.0" encoding="utf-8"?>
<!-- Latido suave del corazón (eje X). Keyframes dentro de
     propertyValuesHolder (ver bell_swing.xml). -->
<objectAnimator xmlns:android="http://schemas.android.com/apk/res/android"
    android:duration="240">
    <propertyValuesHolder
        android:propertyName="scaleX"
        android:valueType="floatType">
        <keyframe android:fraction="0" android:value="1" />
        <keyframe android:fraction="0.35" android:value="1.18" />
        <keyframe android:fraction="0.6" android:value="0.98" />
        <keyframe android:fraction="1" android:value="1" />
    </propertyValuesHolder>
</objectAnimator>
