<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Red: conexión con la hoja de cálculo (modo conectado) y estado offline. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Háptica suave al confirmar acciones. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Avisos de ofertas y candidaturas (Android 13+; se pide al activar
         las notificaciones en Perfil). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foto de perfil / logotipo: tomar foto con la cámara. -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- La cámara es opcional: si el dispositivo no tiene, se usa la galería.
         Sin esto, Play excluiría los dispositivos sin cámara. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Foto de perfil / logotipo: la galería se abre con el selector de
         documentos del sistema (OpenDocument) y la cámara con FileProvider,
         así que no hace falta ningún permiso de medios. -->

    <application
        android:name=".CubaPinchaApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CubaPincha">
        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Enlace compartido de una oferta: abre la ficha en la app.
                 cubapincha://oferta/{id} y https://henrytmr.github.io/cubapincha/oferta.html?id={id} -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cubapincha" android:host="oferta" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cubapincha" android:host="auth" android:path="/callback" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="henrytmr.github.io" android:pathPrefix="/cubapincha/" />
            </intent-filter>
        </activity>

        <!-- Notificaciones push reales (FCM): recibe los mensajes del
             servidor y los muestra como notificaciones del sistema. -->
        <service
            android:name=".util.CubaPinchaMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="cubapincha" />

        <!-- Comparte la foto tomada con la cámara de forma segura. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
